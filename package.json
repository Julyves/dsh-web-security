{
  "name": "dsh-web-security",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin: secure external access for the Web UI — a high-security login gate (password + passkey) with a TLS reverse-proxy entry into the loopback host.",
  "type": "module",
  "license": "MIT",
  "author": "Julyves",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:Julyves/dsh-web-security.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "security",
    "authentication",
    "passkey",
    "web-ui"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/host/index.js",
  "types": "lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "pack": "npm pack",
    "smoke": "npm run build && node tests/smoke-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.0.1-rc.1 <0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.27.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3"
  }
}
